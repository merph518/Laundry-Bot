{
  "name": "laundry_bot",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "build/laundryBot.js",
  "scripts": {
    "build": "rimraf ./build && tsc",
    "buildDev": "rimraf ./build && tsc && node --no-warnings=ExperimentalWarning --loader ts-node/esm/transpile-only src/laundryBot.ts",
    "buildProd": "pm2 delete laundryBot || true && tsc && pm2 start build/laundryBot.js",
    "bs": "tsc && node build/laundryBot.js",
    "dev": "node --no-warnings=ExperimentalWarning --loader ts-node/esm/transpile-only src/laundryBot.ts",
    "start": "node build/laundryBot.js",
    "start:prod": "pm2 start build/laundryBot.js",
    "watch": "nodemon --exec npm run dev --watch src --ext ts",
    "compile": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@discordx/importer": "^1.3.1",
    "discord.js": "^14.15.3",
    "discordx": "^11.11.1",
    "dotenv": "^18.0.9",
    "luxon": "^3.7.2",
    "oracledb": "^6.10.0",
    "pm2": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "@types/oracledb": "^6.10.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "nodemon": "^3.1.3",
    "prettier": "^3.3.2",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.46.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
